label = "ex2-separate-model-view-controller/ - build, test, and watch (press Ctrl+C first if a project is already running)"
icon = "bs-arrow-repeat"
text = "deno task ex2"

[[session.shortcut]]
label = "ex3-redraw-only-when-changed/ - build, test, and watch (press Ctrl+C first if a project is already running)"
